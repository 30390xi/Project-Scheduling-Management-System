+    @Test
+    void reviewCompanyAdminCannotTakeOverAnotherCompanyAccount() throws Exception {
+        UUID attackerCompany = newCompany("review attacker company");
+        UUID victimCompany = newCompany("review victim company");
+        newUser("review-attacker", "Review-attacker-pass1");
+        newUser("review-victim", "Review-victim-pass1");
+        addMember(attackerCompany, userId("review-attacker"), "ADMIN");
+        addMember(victimCompany, userId("review-victim"), "ADMIN");
+        var attacker = loginOk("review-attacker", "Review-attacker-pass1");
+        var added = write(attacker, "POST", "/api/v1/members", attackerCompany,
+                "{\"username\":\"review-victim\",\"role\":\"MEMBER\"}");
+        assertThat(added.statusCode()).isEqualTo(200);
+        String addedMemberId = json(added).at("/data/memberId").asText();
+        var reset = write(attacker, "POST", "/api/v1/members/" + addedMemberId + "/password-reset",
+                attackerCompany, "{\"reason\":\"review security test\"}");
+        assertThat(reset.statusCode()).isEqualTo(200);
+        String temporary = json(reset).at("/data/temporaryPassword").asText();
+        var impersonated = loginOk("review-victim", temporary);
+        var changed = write(impersonated, "POST", "/api/v1/me/password", null,
+                mapper.writeValueAsString(java.util.Map.of("currentPassword", temporary,
+                        "newPassword", "Review-new-victim-pass1")));
+        assertThat(changed.statusCode()).isEqualTo(200);
+        var stolenSession = loginOk("review-victim", "Review-new-victim-pass1");
+        assertThat(get(stolenSession, "/api/v1/projects", victimCompany).statusCode())
+                .as("Company A admin must not obtain authenticated access to company B")
+                .isNotEqualTo(200);
+    }
