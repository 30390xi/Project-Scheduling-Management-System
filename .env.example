# Copy to .env; used by Docker Compose and scripts/dev.sh. Never commit .env.
COMPOSE_PROJECT_NAME=ai-project-scheduler
DB_NAME=scheduler
DB_USER=scheduler
DB_PASSWORD=local-db-change-me
DB_PORT=54329
SERVER_PORT=8080
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=local-admin-change-me

# AI defaults to disabled. Use standard API billing, not a Coding Plan endpoint.
# DeepSeek example (enable only after setting your local key):
AI_PROVIDER=disabled
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_JSON_MODE=true
AI_THINKING_MODE=disabled
AI_MAX_OUTPUT_TOKENS=8192
AI_REQUEST_TIMEOUT=45s
AI_RUN_DEADLINE=180s
AI_MAX_CALLS_PER_RUN=4
# GLM standard API alternative: https://open.bigmodel.cn/api/paas/v4
# Select a model available in your account; see docs/model-integration.md.
